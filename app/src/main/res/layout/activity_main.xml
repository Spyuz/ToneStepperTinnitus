<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="26dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tone Stepper"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Versione 0.4 • Random Stereo"
            android:textSize="13sp"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:text="Frequenza acufene:"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/frequency"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:hint="Hz"
            android:inputType="numberDecimal"
            android:gravity="center" />

        <TextView
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Intervallo:"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/interval"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:hint="Millisecondi"
            android:inputType="number"
            android:gravity="center" />

        <TextView
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Durata:"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/duration"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:hint="Minuti"
            android:inputType="numberDecimal"
            android:gravity="center" />

        <TextView
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:text="0 = riproduzione senza limite"
            android:textSize="11sp"
            android:gravity="center" />

        <TextView
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Volume toni"
            android:textStyle="bold"
            android:gravity="center" />

        <SeekBar
            android:id="@+id/toneVolume"
            android:layout_width="290dp"
            android:layout_height="wrap_content"
            android:max="100" />

        <TextView
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Rumore di fondo"
            android:textStyle="bold"
            android:gravity="center" />

        <Spinner
            android:id="@+id/noiseType"
            android:layout_width="270dp"
            android:layout_height="48dp"
            android:gravity="center" />

        <TextView
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:text="Volume rumore"
            android:textStyle="bold"
            android:gravity="center" />

        <SeekBar
            android:id="@+id/noiseVolume"
            android:layout_width="290dp"
            android:layout_height="wrap_content"
            android:max="100" />

        <Button
            android:id="@+id/start"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="START" />

        <Button
            android:id="@+id/stop"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="STOP" />

        <TextView
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="I controlli possono essere modificati durante la riproduzione."
            android:textSize="11sp"
            android:gravity="center" />

    </LinearLayout>

</ScrollView>
