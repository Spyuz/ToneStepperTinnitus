<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="26dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tone Stepper"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Random Stereo"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/frequency"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:hint="Frequenza centrale (Hz)"
            android:inputType="numberDecimal"
            android:text="15000"
            android:gravity="center" />

        <EditText
            android:id="@+id/duration"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:hint="Durata tono (ms)"
            android:inputType="numberDecimal"
            android:text="500"
            android:gravity="center" />

        <EditText
            android:id="@+id/sessionMinutes"
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:hint="Durata sessione (minuti)"
            android:inputType="numberDecimal"
            android:text="0"
            android:gravity="center" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 = riproduzione continua"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Volume toni" />

        <SeekBar
            android:id="@+id/toneVolume"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="10" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Rumore di fondo" />

        <Spinner
            android:id="@+id/noiseType"
            android:layout_width="270dp"
            android:layout_height="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volume rumore" />

        <SeekBar
            android:id="@+id/noiseVolume"
            android:layout_width="280dp"
            android:layout_height="wrap_content"
            android:max="100"
            android:progress="5" />

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Pronto"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <Button
            android:id="@+id/start"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="START" />

        <Button
            android:id="@+id/stop"
            android:layout_width="260dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:text="STOP" />

    </LinearLayout>

</ScrollView>
